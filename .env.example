# =============================================================
# overleaf-admin -- variables de entorno
# Copia este archivo como .env y ajusta los valores.
# Mantener solo ASCII en este archivo para evitar problemas de encoding.
# =============================================================

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
DEBUG=true

# --- PostgreSQL (base de datos propia de la plataforma) ---
# Usando Docker Compose local:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=overleaf_admin
POSTGRES_USER=overleaf_admin
POSTGRES_PASSWORD=overleaf_admin_pass
# En Linux/Mac usa el driver por defecto:
DATABASE_URL=postgresql://overleaf_admin:overleaf_admin_pass@localhost:5432/overleaf_admin
# En Windows con locale espanol usa el prefijo +pg8000 para evitar el bug de
# encoding en psycopg2 (ver docs/problemas-y-soluciones.md):
# DATABASE_URL=postgresql+pg8000://overleaf_admin:overleaf_admin_pass@localhost:5432/overleaf_admin

# --- MongoDB de Overleaf Community Edition ---
# Overleaf CE corre en WSL con Docker Compose.
# Desde Windows/Host: usa localhost si hay port-forward.
# Base de datos de Overleaf: normalmente "sharelatex"
# Puerto por defecto: 27017
# directConnection=true es necesario cuando Overleaf CE usa ReplicaSet interno (hostname 'mongo')
MONGO_URI=mongodb://localhost:27017/sharelatex?directConnection=true
MONGO_DB=sharelatex

# Si MongoDB requiere autenticacion (Overleaf CE por defecto NO la usa):
# MONGO_URI=mongodb://usuario:contrasena@localhost:27017/sharelatex

# --- Sincronizacion ---
# Intervalo de sincronizacion automatica en segundos (0 = desactivado)
SYNC_INTERVAL=0

# --- Estado de servicios Docker (opcional) ---
DOCKER_SOCKET=unix:///var/run/docker.sock

# Nombre del proyecto Docker Compose de Overleaf
OVERLEAF_COMPOSE_PROJECT=sharelatex

# --- Email / SMTP ---
# Por defecto SMTP_MOCK=true: los correos se imprimen en consola sin enviar.
# Para enviar correos reales, configura SMTP_MOCK=false y rellena los campos.
SMTP_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5000

# --- Gmail: como configurar ---
# 1. Activa la verificacion en 2 pasos en tu cuenta de Google
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. Crea una contrasena de aplicacion para "Correo"
# 4. Configura las variables asi:
#    SMTP_MOCK=false
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USE_TLS=true
#    SMTP_USER=tu-email@gmail.com
#    SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   (contrasena de app, NO la normal)
#    SMTP_FROM=tu-email@gmail.com
#    APP_BASE_URL=http://localhost:5000

# --- Admin por defecto ---
# Solo para el script scripts/create_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@localhost
